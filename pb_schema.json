[
  {
    "id": "users_collection",
    "name": "users",
    "type": "auth",
    "system": false,
    "schema": [
      {
        "id": "name_field",
        "name": "name",
        "type": "text",
        "system": false,
        "required": true,
        "unique": false,
        "options": {
          "min": 1,
          "max": 255
        }
      },
      {
        "id": "role_field",
        "name": "role",
        "type": "select",
        "system": false,
        "required": true,
        "unique": false,
        "options": {
          "maxSelect": 1,
          "values": ["employee", "admin"]
        }
      },
      {
        "id": "mustChangePassword_field",
        "name": "mustChangePassword",
        "type": "bool",
        "system": false,
        "required": false,
        "unique": false,
        "options": {}
      }
    ],
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "@request.auth.role = 'admin'",
    "updateRule": "@request.auth.id = id || @request.auth.role = 'admin'",
    "deleteRule": "@request.auth.role = 'admin'",
    "options": {
      "allowEmailAuth": true,
      "allowOAuth2Auth": false,
      "allowUsernameAuth": false,
      "exceptEmailDomains": null,
      "manageRule": null,
      "minPasswordLength": 4,
      "onlyEmailDomains": null,
      "requireEmail": true
    }
  },
  {
    "id": "courses_collection",
    "name": "courses",
    "type": "base",
    "system": false,
    "schema": [
      {
        "id": "title_field",
        "name": "title",
        "type": "text",
        "system": false,
        "required": true,
        "unique": false,
        "options": {
          "min": 1,
          "max": 255
        }
      },
      {
        "id": "description_field",
        "name": "description",
        "type": "text",
        "system": false,
        "required": false,
        "unique": false,
        "options": {
          "min": null,
          "max": 1000
        }
      },
      {
        "id": "validityDays_field",
        "name": "validityDays",
        "type": "number",
        "system": false,
        "required": true,
        "unique": false,
        "options": {
          "min": 1,
          "max": null
        }
      },
      {
        "id": "content_field",
        "name": "content",
        "type": "json",
        "system": false,
        "required": false,
        "unique": false,
        "options": {}
      },
      {
        "id": "quiz_field",
        "name": "quiz",
        "type": "json",
        "system": false,
        "required": false,
        "unique": false,
        "options": {}
      }
    ],
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "@request.auth.role = 'admin'",
    "updateRule": "@request.auth.role = 'admin'",
    "deleteRule": "@request.auth.role = 'admin'",
    "options": {}
  },
  {
    "id": "progress_collection",
    "name": "progress",
    "type": "base",
    "system": false,
    "schema": [
      {
        "id": "user_field",
        "name": "user",
        "type": "relation",
        "system": false,
        "required": true,
        "unique": false,
        "options": {
          "collectionId": "users_collection",
          "cascadeDelete": true,
          "minSelect": null,
          "maxSelect": 1,
          "displayFields": ["name"]
        }
      },
      {
        "id": "course_field",
        "name": "course",
        "type": "relation",
        "system": false,
        "required": true,
        "unique": false,
        "options": {
          "collectionId": "courses_collection",
          "cascadeDelete": true,
          "minSelect": null,
          "maxSelect": 1,
          "displayFields": ["title"]
        }
      },
      {
        "id": "date_field",
        "name": "date",
        "type": "date",
        "system": false,
        "required": true,
        "unique": false,
        "options": {
          "min": "",
          "max": ""
        }
      },
      {
        "id": "score_field",
        "name": "score",
        "type": "number",
        "system": false,
        "required": false,
        "unique": false,
        "options": {
          "min": 0,
          "max": 100
        }
      }
    ],
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "@request.auth.id = user || @request.auth.role = 'admin'",
    "updateRule": "@request.auth.id = user || @request.auth.role = 'admin'",
    "deleteRule": "@request.auth.role = 'admin'",
    "options": {}
  }
]
